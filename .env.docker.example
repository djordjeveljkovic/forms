# Copy this file to .env before running `docker compose up` for the first time.
# Generate a fresh APP_KEY with:
#   docker compose run --rm app php artisan key:generate --show

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Forms
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Map of every host that should be allowed to call the API from a browser.
# In production, list your real domain(s) separated by commas.
ASSET_URL=
TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=forms
DB_USERNAME=forms
DB_PASSWORD=forms
DB_ROOT_PASSWORD=forms_root

# Connection-pool tuning (per worker)
DB_POOL_MIN=1
DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Session / Cache / Queue / Broadcast
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=redis
CACHE_PREFIX=forms

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Public-facing form settings
# ---------------------------------------------------------------------------
FORMS_MAX_SUBMISSION_SIZE_KB=256
FORMS_SUBMISSION_RATE_LIMIT=60
FORMS_GLOBAL_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Backups (used by the `backup` profile)
# ---------------------------------------------------------------------------
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Security / Crypto
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file
